<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:number="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet"><office:font-face-decls><style:font-face style:name="Noto Sans" svg:font-family="'Noto Sans'" style:font-family-generic="swiss"/><style:font-face style:name="Noto Serif" svg:font-family="'Noto Serif'" style:font-family-generic="roman"/></office:font-face-decls><office:styles><style:default-style style:family="table-cell"><style:table-cell-properties fo:padding="0.03in"/><style:text-properties style:font-name="Noto Sans" fo:font-size="10.5pt" fo:color="#1d1d1f" fo:language="en" fo:country="US"/></style:default-style><style:style style:name="Default" style:family="table-cell"/><number:currency-style style:name="N1P0" style:volatile="true"><number:currency-symbol>$</number:currency-symbol><number:number number:decimal-places="2" number:min-decimal-places="2" number:min-integer-digits="1" number:grouping="true"/></number:currency-style><number:currency-style style:name="N1"><style:text-properties fo:color="#c01c28"/><number:text>-</number:text><number:currency-symbol>$</number:currency-symbol><number:number number:decimal-places="2" number:min-decimal-places="2" number:min-integer-digits="1" number:grouping="true"/><style:map style:condition="value()&gt;=0" style:apply-style-name="N1P0"/></number:currency-style><number:date-style style:name="N2"><number:month number:textual="true"/><number:text> </number:text><number:day/><number:text>, </number:text><number:year number:style="long"/></number:date-style></office:styles><office:automatic-styles><number:percentage-style style:name="N3"><number:number number:decimal-places="0" number:min-integer-digits="1"/><number:text>%</number:text></number:percentage-style><style:style style:name="co" style:family="table-column"><style:table-column-properties style:column-width="1.2in"/></style:style><style:style style:name="co0" style:family="table-column"><style:table-column-properties style:column-width="2.8in"/></style:style><style:style style:name="co1" style:family="table-column"><style:table-column-properties style:column-width="1in"/></style:style><style:style style:name="co2" style:family="table-column"><style:table-column-properties style:column-width="1.3in"/></style:style><style:style style:name="co3" style:family="table-column"><style:table-column-properties style:column-width="1.4in"/></style:style><style:style style:name="ro" style:family="table-row"><style:table-row-properties style:row-height="0.26in" style:use-optimal-row-height="false"/></style:style><style:style style:name="rot" style:family="table-row"><style:table-row-properties style:row-height="0.5in" style:use-optimal-row-height="false"/></style:style><style:style style:name="ta1" style:family="table" style:master-page-name="Default"><style:table-properties table:display="true"/></style:style><style:style style:name="title" style:family="table-cell" style:parent-style-name="Default"><style:table-cell-properties /><style:text-properties fo:font-size="20pt" fo:font-weight="bold"/></style:style><style:style style:name="sub" style:family="table-cell" style:parent-style-name="Default"><style:table-cell-properties /><style:text-properties fo:color="#6e6e73"/></style:style><style:style style:name="head" style:family="table-cell" style:parent-style-name="Default"><style:table-cell-properties fo:background-color="#2a6fdb"/><style:paragraph-properties fo:text-align="start"/><style:text-properties fo:font-weight="bold" fo:color="#ffffff"/></style:style><style:style style:name="headr" style:family="table-cell" style:parent-style-name="Default"><style:table-cell-properties fo:background-color="#2a6fdb"/><style:paragraph-properties fo:text-align="end"/><style:text-properties fo:font-weight="bold" fo:color="#ffffff"/></style:style><style:style style:name="money" style:family="table-cell" style:parent-style-name="Default" style:data-style-name="N1"><style:table-cell-properties /><style:text-properties /></style:style><style:style style:name="moneyb" style:family="table-cell" style:parent-style-name="Default" style:data-style-name="N1"><style:table-cell-properties fo:border-top="1pt solid #1d1d1f"/><style:text-properties fo:font-weight="bold"/></style:style><style:style style:name="bold" style:family="table-cell" style:parent-style-name="Default"><style:table-cell-properties fo:border-top="1pt solid #1d1d1f"/><style:text-properties fo:font-weight="bold"/></style:style><style:style style:name="band" style:family="table-cell" style:parent-style-name="Default"><style:table-cell-properties fo:background-color="#f2f5fa"/><style:text-properties /></style:style><style:style style:name="bandmoney" style:family="table-cell" style:parent-style-name="Default" style:data-style-name="N1"><style:table-cell-properties fo:background-color="#f2f5fa"/><style:text-properties /></style:style><style:style style:name="date" style:family="table-cell" style:parent-style-name="Default" style:data-style-name="N2"><style:table-cell-properties /><style:text-properties /></style:style><style:style style:name="banddate" style:family="table-cell" style:parent-style-name="Default" style:data-style-name="N2"><style:table-cell-properties fo:background-color="#f2f5fa"/><style:text-properties /></style:style><style:style style:name="done" style:family="table-cell" style:parent-style-name="Default"><style:table-cell-properties /><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-weight="bold" fo:color="#2e7d32"/></style:style><style:style style:name="pct" style:family="table-cell" style:parent-style-name="Default" style:data-style-name="N3"><style:table-cell-properties /><style:text-properties /></style:style></office:automatic-styles><office:body><office:spreadsheet><table:table table:name="Invoice" table:style-name="ta1"><table:table-column table:style-name="co0"/><table:table-column table:style-name="co1"/><table:table-column table:style-name="co2"/><table:table-column table:style-name="co3"/><table:table-row table:style-name="rot"><table:table-cell table:style-name="title" office:value-type="string"><text:p>Invoice</text:p></table:table-cell><table:table-cell/><table:table-cell table:style-name="sub" office:value-type="string"><text:p>Invoice #</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>0001</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro"><table:table-cell table:style-name="sub" office:value-type="string"><text:p>Your Business Name</text:p></table:table-cell><table:table-cell/><table:table-cell table:style-name="sub" office:value-type="string"><text:p>Date</text:p></table:table-cell><table:table-cell table:style-name="date" office:value-type="date" office:date-value="2026-11-07"><text:p>2026-11-07</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro"><table:table-cell table:style-name="sub" office:value-type="string"><text:p>you@example.com</text:p></table:table-cell><table:table-cell/><table:table-cell table:style-name="sub" office:value-type="string"><text:p>Due</text:p></table:table-cell><table:table-cell table:style-name="date" office:value-type="date" office:date-value="2026-12-07"><text:p>2026-12-07</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro"></table:table-row><table:table-row table:style-name="ro"><table:table-cell table:style-name="bold" office:value-type="string"><text:p>Bill to</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro"><table:table-cell office:value-type="string"><text:p>Client Name</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro"><table:table-cell office:value-type="string"><text:p>Client address</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro"></table:table-row><table:table-row table:style-name="ro"><table:table-cell table:style-name="head" office:value-type="string"><text:p>Description</text:p></table:table-cell><table:table-cell table:style-name="headr" office:value-type="string"><text:p>Quantity</text:p></table:table-cell><table:table-cell table:style-name="headr" office:value-type="string"><text:p>Rate</text:p></table:table-cell><table:table-cell table:style-name="headr" office:value-type="string"><text:p>Amount</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro"><table:table-cell office:value-type="string"><text:p>Consulting (hours)</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="12"><text:p>12</text:p></table:table-cell><table:table-cell table:style-name="money" office:value-type="currency" office:currency="USD" office:value="150"><text:p>$150.00</text:p></table:table-cell><table:table-cell table:style-name="money" table:formula="of:=[.B10]*[.C10]"/></table:table-row><table:table-row table:style-name="ro"><table:table-cell table:style-name="band" office:value-type="string"><text:p>Design review</text:p></table:table-cell><table:table-cell table:style-name="band" office:value-type="float" office:value="1"><text:p>1</text:p></table:table-cell><table:table-cell table:style-name="bandmoney" office:value-type="currency" office:currency="USD" office:value="600"><text:p>$600.00</text:p></table:table-cell><table:table-cell table:style-name="bandmoney" table:formula="of:=[.B11]*[.C11]"/></table:table-row><table:table-row table:style-name="ro"><table:table-cell office:value-type="string"><text:p>Travel</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="1"><text:p>1</text:p></table:table-cell><table:table-cell table:style-name="money" office:value-type="currency" office:currency="USD" office:value="220"><text:p>$220.00</text:p></table:table-cell><table:table-cell table:style-name="money" table:formula="of:=[.B12]*[.C12]"/></table:table-row><table:table-row table:style-name="ro"></table:table-row><table:table-row table:style-name="ro"><table:table-cell/><table:table-cell/><table:table-cell table:style-name="sub" office:value-type="string"><text:p>Subtotal</text:p></table:table-cell><table:table-cell table:style-name="money" table:formula="of:=SUM([.D10:.D12])"/></table:table-row><table:table-row table:style-name="ro"><table:table-cell/><table:table-cell/><table:table-cell table:style-name="sub" office:value-type="string"><text:p>Tax (13%)</text:p></table:table-cell><table:table-cell table:style-name="money" table:formula="of:=[.D14]*0.13"/></table:table-row><table:table-row table:style-name="ro"><table:table-cell/><table:table-cell/><table:table-cell table:style-name="bold" office:value-type="string"><text:p>Total</text:p></table:table-cell><table:table-cell table:style-name="moneyb" table:formula="of:=[.D14]+[.D15]"/></table:table-row></table:table></office:spreadsheet></office:body></office:document>
