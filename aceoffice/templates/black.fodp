draw:text-box><text:list text:style-name="L1"><text:list-item><text:p>Where we are today</text:p></text:list-item><text:list-item><text:p>What we’re proposing</text:p></text:list-item><text:list-item><text:p>What it costs, and when</text:p></text:list-item><text:list-item><text:p>Next steps</text:p></text:list-item></text:list></draw:text-box></draw:frame></draw:page></office:presentation></office:body></office:document>
