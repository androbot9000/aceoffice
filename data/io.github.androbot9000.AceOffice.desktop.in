[Desktop Entry]
Name=AceOffice
GenericName=Office Suite
Comment=Write documents and edit spreadsheets. Opens Word, Excel, Pages and Numbers files.
Exec=@EXEC@ %F
Icon=io.github.androbot9000.AceOffice
Terminal=false
Type=Application
Categories=Office;WordProcessor;Spreadsheet;GTK;GNOME;
Keywords=word;docx;excel;xlsx;pages;numbers;writer;spreadsheet;document;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;application/vnd.oasis.opendocument.text;application/rtf;application/vnd.apple.pages;application/x-iwork-pages-sffpages;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;application/vnd.oasis.opendocument.spreadsheet;text/csv;application/vnd.apple.numbers;application/x-iwork-numbers-sffnumbers;
StartupNotify=true
StartupWMClass=io.github.androbot9000.AceOffice
